{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/telegram/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/mikrotik/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/exports/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/database/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/health/keep-alive",
      "schedule": "0 2 * * *"
    }
  ]
}
