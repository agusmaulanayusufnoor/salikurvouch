# ==============================================================================
# SalikurVouch Environment Variables
# Copy this file to .env.local and fill in the secrets before running locally.
# ==============================================================================

# --- Supabase (Project: salikurvouch / nrvyozahwfihvugtnjbj) ---
NEXT_PUBLIC_SUPABASE_URL=https://nrvyozahwfihvugtnjbj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_540jO6Ms0lPzj5IC4oS0_g_20N3UlV7
# Service role / secret key (SERVER ONLY — never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# --- App Encryption Master Key (64 hex chars = 32 bytes for AES-256-GCM) ---
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- Portal Pulsa (PPOB) API Credentials (SERVER ONLY) ---
PORTALPULSA_USERID=
PORTALPULSA_KEY=
PORTALPULSA_SECRET=
# Optional static-IP HTTP/HTTPS proxy URL for Vercel outbound IP whitelist
PORTALPULSA_PROXY_URL=

# --- Optional Custom Android APK Download URL ---
# Defaults to GitHub Releases latest SalikurVouch.apk if public/downloads/salikurvouch.apk is absent
NEXT_PUBLIC_APK_DOWNLOAD_URL=

# --- Legacy SQLite Migration Script Options ---
LEGACY_BACKUP_DIR=/Users/agusmac/Nextjs/backup_mikbotam
# Initial admin credentials to seed in Supabase Auth during migration (never migrate plaintext)
SEED_ADMIN_EMAIL=admin@salikur.net
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
