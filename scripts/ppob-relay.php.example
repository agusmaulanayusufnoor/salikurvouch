<?php
/**
 * SalikurVouch — PortalPulsa Static-IP HTTPS Relay
 *
 * Upload file ini ke server existing Anda yang IP-nya sudah di-whitelist di PortalPulsa
 * (contoh: https://salikur.net/ppob-relay.php), lalu ganti $RELAY_SECRET dengan
 * token acak panjang Anda sendiri.
 *
 * Di Vercel Environment Variables atau menu Pengaturan -> Router, Bot & PPOB:
 *   PORTALPULSA_PROXY_URL = https://salikur.net/ppob-relay.php?token=GANTI_TOKEN_RAHASIA_ANDA
 */

header('Content-Type: application/json; charset=utf-8');

$RELAY_SECRET = 'GANTI_TOKEN_RAHASIA_MINIMAL_32_KARAKTER';

function get_req_header($name) {
    $serverKey = 'HTTP_' . strtoupper(str_replace('-', '_', $name));
    if (!empty($_SERVER[$serverKey])) {
        return $_SERVER[$serverKey];
    }
    if (function_exists('getallheaders')) {
        $all = getallheaders();
        if (is_array($all)) {
            foreach ($all as $k => $v) {
                if (strcasecmp($k, $name) === 0) {
                    return $v;
                }
            }
        }
    }
    return '';
}

$provided = get_req_header('X-Relay-Token');
if ($provided === '' && isset($_GET['token'])) {
    $provided = (string) $_GET['token'];
}
if ($RELAY_SECRET === 'GANTI_TOKEN_RAHASIA_MINIMAL_32_KARAKTER' || !hash_equals($RELAY_SECRET, $provided)) {
    http_response_code(403);
    echo json_encode(['result' => 'failed', 'message' => 'Unauthorized relay token']);
    exit;
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    echo json_encode(['result' => 'failed', 'message' => 'Method not allowed']);
    exit;
}

$userid = get_req_header('portal-userid');
$key    = get_req_header('portal-key');
$secret = get_req_header('portal-secret');
$body   = file_get_contents('php://input');

$ch = curl_init('https://portalpulsa.com/api/connect/');
curl_setopt_array($ch, [
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_POST           => true,
    CURLOPT_POSTFIELDS     => $body,
    CURLOPT_TIMEOUT        => 25,
    CURLOPT_HTTPHEADER     => [
        'portal-userid: ' . $userid,
        'portal-key: ' . $key,
        'portal-secret: ' . $secret,
        'Content-Type: application/x-www-form-urlencoded',
    ],
]);

$response = curl_exec($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE) ?: 502;
$curlErr  = curl_error($ch);
curl_close($ch);

if ($response === false) {
    http_response_code(502);
    echo json_encode(['result' => 'failed', 'message' => 'Relay cURL error: ' . $curlErr]);
    exit;
}

http_response_code($httpCode);
echo $response;
